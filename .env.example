# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: url-shortener-analytics
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory SQLite database and in-process hit counter.
#
# TIER 2 / TIER 3: PRODUCTION POSTGRESQL & REDIS ANALYTICS
# - Provide PostgreSQL connection string and Redis for click tracking.

DATABASE_URL=postgresql://user:pass@localhost:5432/shortener_db
REDIS_URL=redis://localhost:6379
BASE_URL=http://localhost:3000
PORT=3000
